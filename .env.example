LIVEKIT_URL=wss://meet.chronos.com.pt
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://meet.chronos.com.pt
NEXT_PUBLIC_LIVEKIT_URL=wss://meet.chronos.com.pt
NEXT_PUBLIC_APP_URL=https://meet.chronos.com.pt

PORT=3331
HOST=127.0.0.1

DATABASE_URL=postgresql://chronos_meet:CHANGE_ME@127.0.0.1:5433/chronos_meet

CHRONOS_OAUTH_ISSUER=https://chronos.com.pt
CHRONOS_OAUTH_CLIENT_ID=
CHRONOS_OAUTH_CLIENT_SECRET=
CHRONOS_OAUTH_REDIRECT_URI=https://meet.chronos.com.pt/api/auth/callback/chronos
CHRONOS_MCP_URL=https://chronos.com.pt/mcp

SESSION_SECRET=replace_with_openssl_rand_hex_32
AGENT_SHARED_SECRET=
MEET_MCP_TOKEN=
MEET_API_URL=https://meet.chronos.com.pt

# Comma-separated emails allowed to access /admin (system settings + webhooks)
ADMIN_EMAILS=you@example.com,another@example.com

DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# High-volume calls (insights + chat) — keep Flash-Lite for cost.
GEMINI_MODEL=gemini-3.5-flash-lite
# Post-meeting summary — stronger model (full report, once per meeting).
GEMINI_SUMMARY_MODEL=gemini-3.5-flash
GROQ_API_KEY=

# Copiloto wake word (agent worker)
COPILOT_WAKE_ENABLED=true
COPILOT_WAKE_PHRASES=ei copiloto,hey copiloto,oi copiloto
COPILOT_COMMAND_TIMEOUT_SEC=8

# Meeting recordings (local disk and/or S3-compatible — also configurable in /admin)
RECORDINGS_DIR=/var/chronos-meet/recordings
# RECORDING_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# RECORDING_S3_BUCKET=chronos-meet-recordings
# RECORDING_S3_REGION=fsn1
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET_KEY=
