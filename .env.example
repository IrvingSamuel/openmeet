# Deployment: server (self-host) or platform (managed)
DEPLOYMENT_MODE=server
ALLOW_SIGNUP=true

LIVEKIT_URL=wss://openmeet.chronos.com.pt
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://openmeet.chronos.com.pt
NEXT_PUBLIC_LIVEKIT_URL=wss://openmeet.chronos.com.pt
NEXT_PUBLIC_APP_URL=https://openmeet.chronos.com.pt

PORT=3332
HOST=127.0.0.1

DATABASE_URL=postgresql://openmeet:CHANGE_ME@127.0.0.1:5433/openmeet

# Optional OIDC (when not using local email/password alone)
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://openmeet.chronos.com.pt/api/auth/callback/oidc
OIDC_SCOPES=openid profile email
# Optional path overrides for non-standard issuers:
# OIDC_AUTHORIZE_PATH=/oauth/authorize
# OIDC_TOKEN_PATH=/oauth/token
# OIDC_USERINFO_PATH=/oauth/userinfo

SESSION_SECRET=replace_with_openssl_rand_hex_32
AGENT_SHARED_SECRET=
MEET_MCP_TOKEN=
MEET_API_URL=https://openmeet.chronos.com.pt

# Comma-separated emails allowed to access /admin (system settings + webhooks)
ADMIN_EMAILS=you@example.com,another@example.com

DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# High-volume calls (insights + chat) — keep Flash-Lite for cost.
GEMINI_MODEL=gemini-3.5-flash-lite
# Post-meeting summary — stronger model (full report, once per meeting).
GEMINI_SUMMARY_MODEL=gemini-3.5-flash

# OpenAI-compatible LLM provider (Groq, Ollama, LiteLLM) — replaces Gemini when enabled.
AI_FALLBACK_ENABLED=false
AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=openai/gpt-oss-120b
# AI_FALLBACK_SUMMARY_MODEL=openai/gpt-oss-120b

# Copiloto wake word (agent worker)
COPILOT_WAKE_ENABLED=true
COPILOT_WAKE_PHRASES=ei copiloto,hey copiloto,oi copiloto
COPILOT_COMMAND_TIMEOUT_SEC=8

# Meeting recordings (local disk and/or S3-compatible — also configurable in /admin)
RECORDINGS_DIR=/var/openmeet/recordings
# RECORDING_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# RECORDING_S3_BUCKET=openmeet-recordings
# RECORDING_S3_REGION=fsn1
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET_KEY=
