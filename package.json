{
  "name": "openmeet",
  "version": "1.4.1",
  "description": "Open-source white-label videoconferencing with LiveKit, live captions, and an AI copilot that turns meetings into summaries and webhooks.",
  "license": "MIT",
  "private": false,
  "homepage": "https://openmeet.chronos.com.pt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrvingSamuel/openmeet.git"
  },
  "bugs": {
    "url": "https://github.com/IrvingSamuel/openmeet/issues"
  },
  "keywords": [
    "videoconferencing",
    "livekit",
    "webrtc",
    "white-label",
    "self-hosted",
    "nextjs",
    "open-source",
    "ai-copilot",
    "meetings"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3332",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3332",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@serwist/next": "^9.5.12",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.0",
    "next": "15.1.0",
    "next-intl": "^4.13.5",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@serwist/window": "^9.5.12",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "jsdom": "^30.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
